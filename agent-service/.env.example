# Docker 本机 Postgres（容器内 5432，宿主机映射 15432）
INFRA_HOST=127.0.0.1

# 业务端地址,本机部署的需要填，虚拟机部署的不用填
BUSINESS_SERVICE_URL=http://127.0.0.1:8001

# PostgreSQL - agent-service
POSTGRES_PORT=15432
POSTGRES_DB=insurance_agent
POSTGRES_USER=insurance
POSTGRES_PASSWORD=insurance123

# LLM / model config placeholders
CHAT_MODEL=deepseek-v4-flash
DEEPSEEK_API_KEY=
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=Pro/BAAI/bge-m3

# MinerU
MINERU_TOKEN=

# jwt密钥，需与 biz-service 保持一致
JWT_SECRET=change-me-in-dev
